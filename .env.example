# Copy to .env.local and fill in to use the online version (Supabase).
# Leave empty to keep everything in the browser (no sign-in).
# Both values are in the Supabase dashboard: Project Settings -> API Keys / Data API.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) or, on older projects, the anon key.
# Never use the secret key (sb_secret_...) here: VITE_ values are shipped to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
